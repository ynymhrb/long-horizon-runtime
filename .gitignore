# Long-task validation run artifacts (generated; never commit).
# Immutable per-run evidence bundles (default --evidence-root).
validation/evidence/
# Aggregate metrics/triage output dumps (source code in validation/metrics
# and validation/triage stays tracked; only their generated dumps are ignored).
validation/reports/
validation/metrics/output/
validation/triage/output/
# Disposable harness workspaces / staging if a run ever places them in-repo
# (the default is the OS temp dir, which needs no entry).
lt-validation-*/
lt-evidence-*/
**/.evidence-staging/
validation/.tmp/
validation/tmp/
# Vitest plain-object workaround config generated for Windows-sandbox test runs.
.vitest.triage.temp.config.mjs
# Runtime artifact-store output at the repository root (generated by dev runs).
artifacts/

# Source scenario files (scenarios/**, validation/scenarios/**), the runner
