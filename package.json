{
  "name": "@deepseek-ai/dsh-long-task-runtime",
  "version": "0.3.8",
  "description": "Durable long-horizon task runtime plugin for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js",
      "default": "./dist/tools.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js",
      "default": "./dist/remote.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "aris:pilot": "node validation/aris-pilot/cli.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && pnpm run build:client",
    "build:client": "tsdown --config tsdown.client.config.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:D:/code_github/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:D:/code_github/deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-llm": "link:D:/code_github/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-subagent": "link:D:/code_github/deepseek-harness/packages/subagent/subagent",
    "@deepseek-ai/dsh-tools": "link:D:/code_github/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-typert-protocol": "link:D:/code_github/deepseek-harness/packages/typert/protocol",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
